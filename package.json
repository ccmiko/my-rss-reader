{
  "name": "my-rss-reader",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "local:debug": "tsx src/test.ts",
    "local:execute": "node ./dist/index.cjs",
    "lint": "npm run format && tsc --noEmit && publint && eslint ./src/ --ext .ts",
