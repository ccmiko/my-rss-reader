  "author": "",
  "license": "GPL-3.0-only",
  "description": "RSSリーダー作ってみた",
  "volta": {
    "node": "24.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.12",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "publint": "^0.3.17",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.985.0",
    "@aws-sdk/lib-dynamodb": "^3.985.0",
    "@aws-sdk/util-dynamodb": "^3.985.0",
    "rss-parser": "^3.13.0"
